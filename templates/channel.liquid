{%- assign page_title = page.name | default: page.link_text -%}
{%- assign hero_image = page.settings.hero_image_url | default: page.settings.thumb_image_url | presence -%}
{%- assign description = page.settings.description | presence -%}
{%- assign event_type = page.settings.event_type | presence -%}
{%- assign start_dt = page.settings.start_datetime | presence -%}
{%- assign end_dt = page.settings.end_datetime | presence -%}
{%- assign address = page.settings.address | presence -%}
{%- assign registration_url = page.settings.registration_url | presence -%}
{%- assign key_points = page.settings.key_points | presence -%}
{%- assign video_asset = page.settings.video_url | presence -%}
{%- assign asset_url = page.settings.asset_url | presence -%}

<main class="flex-1 bg-base-100">
  <section class="border-b border-base-300/50 bg-gradient-to-br from-base-100 to-base-200/70">
    <div class="page-container py-12 lg:py-16">
      <nav class="mb-5 flex items-center gap-2 text-sm text-base-content/60">
        <a href="{{ site.index_path }}" class="breadcrumb-link" data-turbo-frame="main-content-frame" data-turbo-action="advance">{{ 'generic.events' | t }}</a>
        <span>/</span>
        <span class="text-base-content">{% render 'page_title', item: page %}</span>
      </nav>

      <div class="grid items-start gap-8 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">{{ 'templates.channel.kicker' | t }}</p>
          {%- if page.settings.featured -%}
            <span class="badge badge-outline mt-3 gap-1 border-base-300 bg-base-100 text-base-content/80">
              <i data-lucide="star" class="h-3.5 w-3.5 text-accent"></i>
              {{ 'generic.featured' | t }}
            </span>
          {%- endif -%}
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-accent lg:text-5xl">{{ page_title }}</h1>
          {%- if description -%}
            <p class="mt-4 text-base text-base-content/75 lg:text-lg">{{ description }}</p>
          {%- endif -%}
          <div class="mt-7 flex flex-wrap gap-3">
            {%- if registration_url -%}
              <a href="{{ registration_url }}" class="btn btn-primary btn-lg">{{ 'templates.channel.register' | t }}</a>
            {%- endif -%}
            {%- if asset_url -%}
              <a href="{{ asset_url }}" class="btn btn-outline btn-lg">{{ 'templates.channel.download_asset' | t }}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="overflow-hidden rounded-box border border-base-300/50 bg-base-200">
          {%- if hero_image -%}
            <img class="aspect-[16/10] w-full object-cover" src="{{ hero_image }}" alt="" loading="lazy" />
          {%- else -%}
            <div class="flex aspect-[16/10] items-center justify-center text-base-content/30">
              <i data-lucide="calendar-heart" class="h-14 w-14"></i>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <section class="page-container py-10">
    <div class="surface-panel grid gap-6 p-6 md:grid-cols-2 xl:grid-cols-4">
      <div>
        <p class="text-xs uppercase tracking-wider text-base-content/50">{{ 'templates.channel.start' | t }}</p>
        <p class="mt-1 font-medium text-base-content">{% if start_dt %}{{ start_dt | date: "%b %d, %Y" }}{% else %}{{ 'generic.tba' | t }}{% endif %}</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-base-content/50">{{ 'templates.channel.end' | t }}</p>
        <p class="mt-1 font-medium text-base-content">{% if end_dt %}{{ end_dt | date: "%b %d, %Y" }}{% else %}{{ 'generic.tba' | t }}{% endif %}</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-base-content/50">{{ 'templates.channel.event_type' | t }}</p>
        <p class="mt-1 font-medium text-base-content">{% if event_type %}{{ event_type }}{% else %}{{ 'templates.channel.event_type_fallback' | t }}{% endif %}</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-base-content/50">{{ 'templates.channel.address' | t }}</p>
        <p class="mt-1 font-medium text-base-content">{% if address %}{{ address }}{% else %}{{ 'templates.channel.address_fallback' | t }}{% endif %}</p>
      </div>
    </div>
  </section>

  {%- if key_points -%}
    <section class="page-container pb-10">
      <h2 class="section-heading">{{ 'templates.channel.key_points' | t }}</h2>
      <div class="prose prose-neutral surface-panel mt-4 max-w-none p-6 text-base-content/85">
        {{ key_points | newline_to_br }}
      </div>
    </section>
  {%- endif -%}

  {%- if page.settings.content != blank -%}
    <section class="page-container pb-10">
      <h2 class="section-heading">{{ 'templates.channel.overview' | t }}</h2>
      <article class="ProseMirror prose prose-neutral surface-panel mt-4 max-w-none p-6">
        {{ page.settings.content }}
      </article>
    </section>
  {%- endif -%}

  {%- if video_asset -%}
    <section class="page-container pb-10">
      <h2 class="section-heading">{{ 'templates.channel.video' | t }}</h2>
      <div class="surface-panel mt-4 overflow-hidden p-2">
        <video class="aspect-video w-full rounded-lg object-cover" controls playsinline preload="metadata">
          <source src="{{ video_asset }}" />
        </video>
      </div>
    </section>
  {%- endif -%}

  <section class="page-container pb-14">
    <div class="grid gap-10 lg:grid-cols-3">
      <div>
        <h2 class="section-heading">{{ 'templates.channel.news' | t }}</h2>
        <div class="mt-5 space-y-4">
          {%- for item in page.children_in_list -%}
            {%- if item.template_style == "article" -%}
              {% render 'post_card', post: item, variant: "horizontal" %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div>
        <h2 class="section-heading">{{ 'templates.channel.speakers' | t }}</h2>
        <div class="mt-5 grid gap-4">
          {%- for item in page.children_in_list -%}
            {%- if item.template_style == "person" -%}
              {% render 'speaker_card', speaker: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div>
        <h2 class="section-heading">{{ 'templates.channel.assets' | t }}</h2>
        <div class="mt-5 space-y-4">
          {%- for item in page.children_in_list  -%}
            {%- if item.template_style == "asset" -%}
              {% render 'asset_card', item: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</main>

{% schema %}
  {
    "name": "t:schema.templates.channel.name",
    "description": "t:schema.templates.channel.description",
    "thumb_url": "images/theme/preview-index.png",
    "preview_image_urls": ["images/theme/preview-index.png"],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "description",
        "type": "textarea",
        "label": "t:schema.templates.channel.settings.description.label",
        "rows": 3
      },
      {
        "id": "tags",
        "type": "tag_picker",
        "multiple": true,
        "label": "t:schema.templates.channel.settings.tags.label",
        "queryable": true
      },
      {
        "id": "content",
        "type": "richtext",
        "label": "t:schema.templates.channel.settings.content.label",
        "to_markdown": true
      },
      {
        "id": "key_points",
        "type": "textarea",
        "label": "t:schema.templates.channel.settings.key_points.label",
        "rows": 5,
        "to_markdown": true
      },
      {
        "id": "thumb_image_url",
        "type": "image_picker",
        "ratio": "4:3",
        "width": 120,
        "label": "t:schema.templates.channel.settings.thumb_image_url.label"
      },
      {
        "id": "hero_image_url",
        "type": "image_picker",
        "ratio": "16:9",
        "width": 300,
        "label": "t:schema.templates.channel.settings.hero_image_url.label"
      },
      {
        "id": "video_url",
        "type": "video_picker",
        "label": "t:schema.templates.channel.settings.video_url.label",
        "ratio": "16:9",
        "width": 300
      },
      {
        "id": "asset_url",
        "type": "dam_picker",
        "label": "t:schema.templates.channel.settings.asset_url.label"
      },
      {
        "id": "start_datetime",
        "type": "date",
        "label": "t:schema.templates.channel.settings.start_datetime.label",
        "queryable": true
      },
      {
        "id": "end_datetime",
        "type": "date",
        "label": "t:schema.templates.channel.settings.end_datetime.label",
        "queryable": true
      },
      {
        "id": "event_type",
        "type": "select",
        "label": "t:schema.templates.channel.settings.event_type.label",
        "choices_from": "$site.event_type",
        "queryable": true
      },
      {
        "id": "address",
        "type": "text",
        "label": "t:schema.templates.channel.settings.address.label",
        "queryable": true
      },
      {
        "id": "registration_url",
        "type": "text",
        "label": "t:schema.templates.channel.settings.registration_url.label"
      },
      {
        "id": "featured",
        "type": "checkbox",
        "label": "t:schema.templates.channel.settings.featured.label",
        "default": false,
        "queryable": true
      }
    ]
  }
{% endschema %}
