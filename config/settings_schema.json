        "default": "webinar\nconference\ntraining\nmeetup"
      },
      {
        "id": "event_status_options",
        "type": "textarea",
        "label": "t:schema.site_settings.settings.event_status_options.label",
        "rows": 3,
        "default": "upcoming\nrecent\npast"
      }
    ]
